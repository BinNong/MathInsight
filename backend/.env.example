# Flask 配置
FLASK_DEBUG=false

# 登录令牌签名密钥（生产环境务必设置为随机强密钥）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 不设置时会自动生成并持久化到 backend/data/secret_key
SECRET_KEY=your_random_secret_key_here

# 登录令牌有效期（秒），默认 30 天
# TOKEN_MAX_AGE=2592000

# 启动时自动将以下已存在的用户提升为管理员（逗号分隔，只提升不降级）
# 首次部署可留空，改用 python manage_users.py promote <用户名> 指定
# ADMIN_USERNAMES=adminuser,anotheradmin

# AI 解题与 Manim 使用 Anthropic Messages API，可填写官方或兼容端点
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro

# 旧配置回退：仅用于兼容已有 Anthropic 兼容端点配置，不是 OpenAI SDK 支持
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# 生产环境使用逗号分隔的允许来源
# ALLOWED_ORIGINS=https://nongbin.site

# ===== 数说热点 · 平台内自动生成 =====
# 总开关：false 时完全停用后台自动生成（只读展示现有内容）
# HOTSPOT_AUTO_ENABLED=true
# 每周哪几天生成，0=周一 1=周二 ... 6=周日，默认周一/三/五
# HOTSPOT_AUTO_WEEKDAYS=0,2,4
# 生成时刻（服务器本地时区），默认 09:00
# HOTSPOT_AUTO_HOUR=9
# HOTSPOT_AUTO_MINUTE=0
# dry-run：true 时只生成并写日志，不写入内容库（上线前验证用）
# HOTSPOT_DRY_RUN=false
# 生成内容最多保留篇数，0 表示不限制
# HOTSPOT_MAX_ITEMS=0
# 生成内容专属模型，留空则复用 ANTHROPIC_MODEL
# HOTSPOT_MODEL=
# LLM 协议：anthropic（默认）或 openai（OpenAI 兼容网关，如高校/第三方平台）
# HOTSPOT_LLM_PROTOCOL=openai
# 专用端点与密钥（留空则按协议回退到上面的通用 ANTHROPIC_* / OPENAI_* 配置）
# HOTSPOT_LLM_BASE_URL=https://example.edu.cn/api/llm/v1
# HOTSPOT_LLM_API_KEY=sk-xxxxxxxx

# 自动生成状态与日志可在管理员接口查看：
#   GET  /api/hotspots/admin/status
#   GET  /api/hotspots/admin/log?limit=80
#   POST /api/hotspots/admin/run     （手动触发一次）
# 需要管理员账号的 Bearer Token。
